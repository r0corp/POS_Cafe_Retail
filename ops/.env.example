# Salin file ini jadi "ops/.env" (tanpa .example) DI MINI PC, lalu isi
# token acak yang panjang - ini kunci satu-satunya yang melindungi
# endpoint /update supaya tidak sembarang orang di jaringan bisa
# memicu update dari jarak jauh.
#
# Generate token acak lewat PowerShell:
#   -join ((48..57)+(65..90)+(97..122)|Get-Random -Count 40|ForEach-Object{[char]$_})
AGENT_TOKEN=ganti-dengan-token-acak-yang-panjang

# Port tempat agent ini mendengarkan (beda dari port aplikasi POS-nya
# sendiri yang di 8000).
AGENT_PORT=8787

# Path folder project POS di mini PC ini.
PROJECT_ROOT=C:\OrulabsPOS

# Cara restart aplikasi POS setelah update:
#   auto -> pakai NSSM kalau nssm.exe ada, kalau tidak pakai Scheduled Task
#   nssm -> paksa selalu pakai NSSM (service Windows)
#   task -> paksa selalu pakai Scheduled Task "CafePOS AutoStart"
SERVICE_MODE=auto
SERVICE_NAME=OrulabsPOS
NSSM_PATH=C:\nssm\nssm.exe
TASK_NAME=CafePOS AutoStart

# --- Khusus laptop dev yang menjalankan Dashboard kontrol deploy ---
# (ops/dashboard_server.py) - TIDAK perlu diisi di ops/.env milik mini PC,
# cuma dipakai kalau laptop ini juga menjalankan dashboard-nya sendiri.
# Dashboard bind ke 0.0.0.0 (bisa diakses dari HP lewat Tailscale) dan
# berisi token semua mini PC, jadi wajib ada password buat login.
DASHBOARD_PASSWORD=ganti-dengan-password-acak
