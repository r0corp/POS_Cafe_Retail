<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Nutupin WebView sampai halaman PERTAMA KALI berhasil kemuat -
         server Flask di Chaquopy butuh beberapa saat buat mulai
         listen, dan tanpa ini pengguna sempat lihat halaman error
         bawaan WebView ("Web page not available") sekilas sebelum
         auto-retry berhasil. Lihat MainActivity - baru disembunyikan
         kalau onPageFinished() bener-bener tanpa error. -->
    <LinearLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_bg"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Sama dengan "LOADING..." setelah login di POS (login-loader-*
             di style.css, mode gelap): teks tebal berjarak lebar + bar
             yang geser terus. Animasinya digerakkan dari MainActivity. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOADING..."
            android:textColor="#38BDF8"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.2" />

        <FrameLayout
            android:id="@+id/splashTrack"
            android:layout_width="220dp"
            android:layout_height="10dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/splash_track"
            android:clipToOutline="true">

            <View
                android:id="@+id/splashFill"
                android:layout_width="88dp"
                android:layout_height="10dp"
                android:background="@drawable/splash_fill" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
